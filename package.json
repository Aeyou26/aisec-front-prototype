{
  "name": "aisec-front",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host",
    "note": "echo '!!!提示 因为编辑器库使用的是md-editor-v3（目前只有这个可以显示图表） 但是他内部使用的外网cdn 在无法使用外网的内网环境会导致异常 所以需要执行 cdn-to-local.js 将cdn下载到本地路径 然后在打包后执行 replace-cdn-urls.js 将cdn替换为本地路径 已添加到build命令中 如果需要替换spline的cdn 请执行 spline-cdn-to-local.js 将cdn下载到本地路径 然后在打包后执行 spline-replace-cdn-urls.js 将cdn替换为本地路径 已添加到build命令中'",
    "build": "node cdn-to-local.js && node spline-cdn-to-local.js && vue-tsc && vite build && node replace-cdn-urls.js && node spline-replace-cdn-urls.js",
    "build:test": "node cdn-to-local.js && node spline-cdn-to-local.js && vue-tsc && vite build --mode=test && node replace-cdn-urls.js && node spline-replace-cdn-urls.js",
    "preview": "vite preview",
    "prepare": "husky install",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write .",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,less.scss}\" --fix"
  },
  "dependencies": {
    "@alova/scene-vue": "^1.4.0",
    "@antv/g6": "^5.0.45",
    "@arco-vue-pro-components/pro-components": "^1.0.2",
    "@splinetool/runtime": "^1.9.82",
    "@types/dompurify": "^3.2.0",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/pdf": "^2.0.10",
    "@vueuse/core": "^10.7.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@wecom/jssdk": "^2.3.1",
    "aieditor": "^1.3.8",
    "alova": "^2.21.5",
    "axios": "^1.9.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "docx-preview": "^0.3.5",
    "dompurify": "^3.2.4",
    "echarts": "5.5.1",
    "echarts-liquidfill": "^3.1.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "html-docx-js": "^0.3.1",
    "js-file-download": "^0.4.12",
    "jsencrypt": "^3.3.2",
    "jsplumb": "^2.15.6",
    "markdown-it": "^14.1.0",
    "md-editor-v3": "^5.4.5",
    "mermaid": "^11.4.1",
    "mitt": "^3.0.0",
    "moment": "^2.30.1",
    "nprogress": "^0.2.0",
    "pdfjs-dist": "^5.1.91",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "recordrtc": "^5.6.2",
    "simplex-noise": "^4.0.3",
    "vue": "^3.3.13",
    "vue-demi": "0.14.6",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@alova/mock": "^1.5.0",
    "@arco-design/web-vue": "^2.53.3",
    "@arco-plugins/vite-vue": "^1.4.5",
    "@arco-themes/vue-gi-demo": "^0.0.48",
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/mouse-wheel": "^2.5.1",
    "@better-scroll/observe-dom": "^2.5.1",
    "@better-scroll/scroll-bar": "^2.5.1",
    "@iconify-json/carbon": "^1.1.21",
    "@types/crypto-js": "^4.2.1",
    "@types/echarts": "^4.9.22",
    "@types/file-saver": "^2.0.7",
    "@types/highlight.js": "^10.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^18.19.3",
    "@types/nprogress": "^0.2.0",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "@unocss/preset-rem-to-px": "^0.58.0",
    "@vitejs/plugin-vue": "^4.1.0",
    "axios": "^1.9.0",
    "consola": "^2.15.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.10.0",
    "husky": "^8.0.3",
    "less": "^4.1.3",
    "lint-staged": "^13.2.1",
    "postcss": "8.5.3",
    "postcss-html": "^1.8.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.6",
    "prettier": "^3.1.1",
    "semver": "^7.3.8",
    "stylelint": "^16.0.2",
    "stylelint-config-recommended-less": "^3.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^35.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-prettier": "^3.0.0",
    "typescript": "^5.3.3",
    "unocss": "^0.58.0",
    "unplugin-auto-import": "^0.17.2",
    "unplugin-icons": "^0.18.1",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^4.5.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-style-import": "^2.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plugin-vue-meta-layouts": "^0.3.4",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^2.1.10"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "{!(package)*.json,*.code-snippets}": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write",
      "git add"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix",
      "stylelint --fix"
    ],
    "*.{scss,less,style,html}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
